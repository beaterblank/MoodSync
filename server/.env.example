MOODSYNC_LIBRARY=./library
MOODSYNC_DB=./data/moodsync.sqlite3
MOODSYNC_HOST=0.0.0.0
MOODSYNC_PORT=8088
MOODSYNC_SYNC_INTERVAL_MINUTES=30
# Parallel acquisition + analysis jobs. Default is 4-12 based on CPU count.
# MOODSYNC_WORKERS=12
# Optional colon-separated roots containing additional plugin directories.
# MOODSYNC_PLUGIN_DIRS=/opt/moodsync-plugins:/home/me/my-plugins
# Optional random token required by the iPhone for Wi-Fi sync.
# MOODSYNC_SYNC_TOKEN=replace-me
